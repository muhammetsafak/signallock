# Single source of truth lives outside this repository
/.ssot/

# Environment files: never commit; document variables in .env.example
.env
.env.*
!.env.example

# OS files
.DS_Store

# Editors and IDEs (shared VS Code settings stay versioned)
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# Generated by Cargo
/target/
debug

# Backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
**/mutants.out*/

# rustc dumps stack traces here when it hits an internal compiler error
rustc-ice-*.txt

# Packaging output
/dist/
*.dmg
*.AppImage
